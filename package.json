{
  "name": "reactkit",
  "version": "0.18.2",
  "description": "Reusable React + TypeScript kit: API client, session, texts and UI components.",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./app": {
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui/themes.css": "./dist/ui/themes.css",
    "./ui/reactkit.css": "./dist/ui/reactkit.css"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-version.mjs && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-router": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
